# Databases — contain financial data
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Wave CSV exports — contain transaction data
*.csv
# Exception: vending circuit data is public event data (no financials)
!VendingCircuit.csv
!data/*.csv

# Secrets / env files
.env
*.env
run_daily.ps1
run_daily.log

# Google service-account key for the calendar sync — grants calendar read access, NEVER commit
*service-account*.json
gcal-*.json

# Streamlit secrets — NEVER commit
.streamlit/secrets.toml

# Personal / sensitive documents — NEVER commit
*.pdf
Sales/

# Images / binary assets
*.png
*.jpg
*.jpeg
*.gif
# Exception: the unified site's brand image assets are intentional web deliverables
!site/assets/img/
!site/assets/img/*

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Chat logs — contain financial figures and business context
CHATLOG.md

# Playwright MCP scratch (screenshots / snapshots from local smoke tests)
.playwright-mcp/

# Square catalog exports/backups (generated dumps of the live menu; regenerate via pull_catalog.py)
catalog_export.json
catalog_backup_*.json
catalog_cleanup_plan.json

# OS
.DS_Store
Thumbs.db

# Claude Code local state — NEVER commit.
# memory-backup/ carries the agent's project memory, which includes credentials
# (e.g. the Supabase service-role key). settings.local.json is machine-specific.
# Do not rely on a global gitignore for this: it won't exist on another machine.
.claude/
